# Application

APP_NAME=EagleEye v2
APP_VERSION=0.1.0
API_TITLE=EagleEye API
API_DESCRIPTION=AI-powered Face Recognition Attendance System
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api/v1

# Database
# SQLAlchemy Async URL
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/eagleeye
TEST_DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/eagleeye_test


# JWT Authentication
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis (Optional for MVP)
REDIS_URL=redis://localhost:6379/0

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# Face Recognition
MODEL_PATH=models/buffalo_l

# CORS
# Comma-separated list
ALLOWED_ORIGINS=http://localhost:3000